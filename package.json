{
  "name": "pptd",
  "productName": "PPTD",
  "version": "0.3.0",
  "description": "PPTD (PowerPoint is dead): play and edit single-file HTML presentations.",
  "license": "GPL-3.0-or-later",
  "author": "Geir Freysson",
  "repository": "github:geirfreysson/pptd",
  "main": "main.js",
  "bin": {
    "pptd": "bin/pptd"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac --dir",
    "dist": "electron-builder --mac",
    "check": "node tools/pptd-check.mjs",
    "postinstall": "node tools/postinstall.mjs",
    "sync-skill": "sh tools/sync-skill.sh",
    "prebuild": "sh tools/sync-skill.sh && node tools/vendor-pi.mjs",
    "predist": "sh tools/sync-skill.sh && node tools/vendor-pi.mjs",
    "icon": "python3 tools/make-icon.py",
    "vendor-pi": "node tools/vendor-pi.mjs"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.pptd.app",
    "productName": "PPTD",
    "files": [
      "main.js",
      "preload.js",
      "deck-preload.js",
      "index.html",
      "renderer.js",
      "package.json",
      "lib/**",
      "agent/**",
      "tools/pptd-check.mjs",
      "tools/pptd-deck.mjs",
      "node_modules/@xterm/xterm/lib/xterm.js",
      "node_modules/@xterm/xterm/css/xterm.css",
      "node_modules/@xterm/addon-fit/lib/addon-fit.js"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "icon": "build/icon.icns",
      "extraResources": [
        {
          "from": "vendor/pi/node_modules",
          "to": "pi/node_modules",
          "filter": [
            "**/*",
            "!**/*.map",
            "!**/*.d.ts",
            "!**/*.d.mts",
            "!**/*.d.cts",
            "!@types/**",
            "!@earendil-works/pi-tui/native/linux/**",
            "!@earendil-works/pi-tui/native/win32/**"
          ]
        },
        {
          "from": "vendor/tools/mac-${arch}",
          "to": "pi/bin",
          "filter": [
            "**/*",
            "!.versions.json"
          ]
        }
      ]
    },
    "fileAssociations": [
      {
        "ext": "html",
        "name": "PPTD presentation",
        "description": "PPTD presentation (*.pptd.html)",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "asarUnpack": [
      "agent/**",
      "node_modules/node-pty/**",
      "tools/pptd-*.mjs"
    ],
    "linux": {
      "extraResources": [
        {
          "from": "vendor/pi/node_modules",
          "to": "pi/node_modules",
          "filter": [
            "**/*",
            "!**/*.map",
            "!**/*.d.ts",
            "!**/*.d.mts",
            "!**/*.d.cts",
            "!@types/**",
            "!@earendil-works/pi-tui/native/darwin/**",
            "!@earendil-works/pi-tui/native/win32/**"
          ]
        },
        {
          "from": "vendor/tools/linux-${arch}",
          "to": "pi/bin",
          "filter": [
            "**/*",
            "!.versions.json"
          ]
        }
      ]
    },
    "win": {
      "extraResources": [
        {
          "from": "vendor/pi/node_modules",
          "to": "pi/node_modules",
          "filter": [
            "**/*",
            "!**/*.map",
            "!**/*.d.ts",
            "!**/*.d.mts",
            "!**/*.d.cts",
            "!@types/**",
            "!@earendil-works/pi-tui/native/darwin/**",
            "!@earendil-works/pi-tui/native/linux/**"
          ]
        },
        {
          "from": "vendor/tools/win-${arch}",
          "to": "pi/bin",
          "filter": [
            "**/*",
            "!.versions.json"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0"
  },
  "allowScripts": {
    "node-pty": false,
    "electron-winstaller": false
  }
}
